# Copy this file to backend/.env and fill in real values.

# Required. Used by services/gemini_service.py to render sprint tickets.
# Get one from Google AI Studio.
GEMINI_API_KEY=

# Optional. Isolation Forest anomaly score cutoff (0.0-1.0). Rows scoring at or
# above this are flagged for pattern matching. Defaults to 0.65 if unset.
ANOMALY_THRESHOLD=0.65

# Optional. Rejects uploads larger than this many megabytes. Defaults to 50 if unset.
MAX_UPLOAD_SIZE_MB=50

# Optional. Comma-separated list of origins allowed to call this API (CORS).
# Defaults to "*" (any origin) if unset -- fine for local development, but set this
# to your actual frontend URL(s) before deploying.
ALLOWED_ORIGINS=*

# Required for auth (GET /auth/me) and Supabase-backed persistence.
# Project URL and the publishable ("anon") key -- from Supabase dashboard -> API settings.
SUPABASE_URL=
SUPABASE_KEY=

# Required for any backend write that must bypass Row Level Security (RLS) --
# e.g. writing reports/prescriptions on a user's behalf once /pipeline/run exists.
# Supabase dashboard -> Project Settings -> API -> service_role secret. Never expose
# this to a frontend/browser context; backend-only.
SUPABASE_SERVICE_ROLE_KEY=

# NOTE: JWT verification (backend/api/auth.py) does NOT use a SUPABASE_JWT_SECRET
# despite the TRD listing one -- this project's Supabase Auth signs tokens with
# ES256 against a rotating public key set at <SUPABASE_URL>/auth/v1/.well-known/jwks.json,
# not a static HS256 shared secret, so no such secret applies here.
