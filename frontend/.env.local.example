# Backend API base URL (no trailing slash). Local: http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase project — same project the backend uses. The anon/publishable key
# is safe to expose in the browser (it relies on RLS, which the backend's
# admin client bypasses on the server side only).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
