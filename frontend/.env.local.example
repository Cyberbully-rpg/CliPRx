# Backend API base URL (no trailing slash). Local: http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# That is the only variable this app needs. The frontend runs in single-tenant
# mode with no login/signup UI, so it holds no Supabase session and talks to no
# Supabase project directly -- the backend owns every Supabase credential and
# resolves unauthenticated requests to DEFAULT_USER_ID (backend/api/auth.py).
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY are no longer read.
